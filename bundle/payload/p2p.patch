+        // Both groups share the peer scratch, just as the real peer does. Sparse destinations must survive
+        // a captured graph replay; untouched rows retain their sentinel, including after an empty submission.
+        require(transport.reset_window(err), err);
+        if (fast) {
+            *(volatile uint32_t*) cpu_ready_h = 0;
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+        }
+        std::memset(expected.data(), 0xA5, bytes * 2);
+        for (size_t i = 0; i < floats; ++i) activations[i] = (float) ((int) (i % 127) - 63 + repeat) * 0.125f;
+        const bool all_primary = repeat % 4 == 0;
+        if (fast) for (size_t i = 0; i < hits.size(); ++i)
+            hits[i] = i % 7 == 0 ? -0.0f : (float) ((int) (i % 131) - 65 + repeat) * 1048576.0f;
+        if (combined) {
+            for (size_t i = 0; i < floats * 2; ++i) cpu_h[i] = (float) ((int) (i % 193) - 96 + repeat) * 0.25f;
+            std::memcpy(expected.data(), cpu_h, bytes * 2);
+            for (int g = 0; g < 2; ++g) for (int row = 0; row < capacity; ++row)
+                if ((g == 0 && all_primary) || row % 11 == 0) {
+                    const size_t start = (size_t) g * floats + (size_t) row * width;
+                    for (int c = 0; c < width; ++c) expected[start + c] = fast && use_fast ? 0.0f + hits[start + c] : 0.0f;
+                }
+        }
+        const uint32_t skip_value = all_primary ? 1 : 0;
+        // Both arrival orders: CPU ready before the peer, or only after the peer has finished its stores.
+        if (fast && repeat % 2 == 0) {
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+            *(volatile uint32_t*) cpu_ready_h = 2;
+        }
+        {
+            OnDevice on(0);
+            cuda_ok(cudaMemcpy(input, activations.data(), bytes, cudaMemcpyHostToDevice));
+            if (fast) cuda_ok(cudaMemcpy(primary_hits, hits.data(), bytes * 2, cudaMemcpyHostToDevice));
+            cuda_ok(cudaMemcpy(skip, &skip_value, 4, cudaMemcpyHostToDevice));
+            cuda_ok(cudaMemset(parts, 0xA5, bytes * 2));
+        }
+        for (int group = 0; group < 2; ++group) {
+            const int count = repeat % 3 == group ? 0 : tokens * 4;
+            dst[group].resize((size_t) count);
+            rows[group].resize((size_t) count * width);
+            int pick = 0;
+            for (int r = 0; r < count; ++r) {
+                int selected;
+                do { selected = (pick++ * 7 + repeat) % capacity; } while (combined && selected % 11 == 0);
+                dst[group][r] = selected; // unique, noncontiguous router-entry positions
+                for (int c = 0; c < width; ++c) rows[group][(size_t) r * width + c] =
+                    (float) ((r * 31 + c + repeat * 13 + group * 17) % 1001 - 500) * 0.0625f;
+                if (!(group == 0 && all_primary))
+                    std::memcpy(expected.data() + (size_t) group * floats + (size_t) dst[group][r] * width,
+                                rows[group].data() + (size_t) r * width, width * sizeof(float));
+            }
+        }
+        {
+            OnDevice on(0);
+            cuda_ok(cudaGraphLaunch(exec, primary_stream));
+        }
+        bool copied_input = false;
+        {
+            OnDevice on(1);
+            for (int group = 0; group < 2; ++group) {
+                if (group == 0 && all_primary) continue; // no host callback at all for the device-plan skip
+                const int count = (int) dst[group].size();
+                if (count) {
+                    cuda_ok(cudaMemcpyAsync(peer_rows, rows[group].data(), rows[group].size() * sizeof(float), cudaMemcpyHostToDevice, peer_stream));
+                    cuda_ok(cudaMemcpyAsync(peer_dst, dst[group].data(), dst[group].size() * sizeof(int32_t), cudaMemcpyHostToDevice, peer_stream));
+                }
+                require(transport.copy_input(peer_input, input, count ? (size_t) tokens * width : 0, peer_stream, err), err);
+                copied_input |= count > 0;
+                require(transport.submit(group, peer_rows, peer_dst, count, (uint32_t) group + 1, peer_stream, err), err);
+            }
+            if (fast && repeat % 2) cuda_ok(cudaStreamSynchronize(peer_stream));
+        }
+        if (fast && repeat % 2) {
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+            *(volatile uint32_t*) cpu_ready_h = 2;
+        }
+        {
+            OnDevice on(0);
+            cuda_ok(cudaStreamSynchronize(primary_stream));
+            require(transport.complete(err), err);
+            cuda_ok(cudaMemcpy(actual.data(), parts, bytes * 2, cudaMemcpyDeviceToHost));
+        }
+        require(std::memcmp(actual.data(), expected.data(), bytes * 2) == 0, "P2P sparse result bytes differ");
+        require(transport.drain(err), err);
+        {
+            OnDevice on(1);
+            cuda_ok(cudaMemcpy(copied.data(), peer_input, (size_t) tokens * width * sizeof(float), cudaMemcpyDeviceToHost));
+        }
+        if (copied_input)
+            require(std::memcmp(copied.data(), activations.data(), (size_t) tokens * width * sizeof(float)) == 0, "P2P input bytes differ");
+        ++passes;
+    }
+    // An aborted graph must drain even with no submission and its transport must reject another window.
+    require(transport.reset_window(err), err);
+    if (fast) {
+        *(volatile uint32_t*) cpu_ready_h = 0;
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+    }
+    {
+        OnDevice on(0);
+        cuda_ok(cudaMemset(skip, 0, 4));
+        cuda_ok(cudaGraphLaunch(exec, primary_stream));
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    transport.release();
+    {
+        OnDevice on(0);
+        cuda_ok(cudaStreamSynchronize(primary_stream));
+    }
+    require(!transport.reset_window(err), "aborted transport was rearmed");
+    require(!transport.complete(err), "aborted transport was reported as valid");
+    watchdog.finish();
+    transport.close();
+    {
+        OnDevice on(0);
+        cuda_ok(cudaGraphExecDestroy(exec)); cuda_ok(cudaGraphDestroy(graph));
+        cuda_ok(cudaStreamDestroy(primary_stream)); cuda_ok(cudaFree(input)); cuda_ok(cudaFree(parts)); cuda_ok(cudaFree(skip));
+        cuda_ok(cudaFree(primary_dst)); cuda_ok(cudaFree(primary_count)); cuda_ok(cudaFreeHost(cpu_h));
+        if (primary_hits) cuda_ok(cudaFree(primary_hits));
+        if (cpu_ready_h) cuda_ok(cudaFreeHost(cpu_ready_h));
+    }
+    {
+        OnDevice on(1);
+        cuda_ok(cudaStreamDestroy(peer_stream)); cuda_ok(cudaFree(peer_input)); cuda_ok(cudaFree(peer_rows)); cuda_ok(cudaFree(peer_dst));
+    }
+    std::printf("peer decode P2P: timing=%d combined_CPU_rows=%d fast_join=%d use_fast=%d, %d captured two-group windows, exact bytes, skip/empty/abort PASS\n",
+                timing, combined, fast, use_fast, passes);
+}
+}
+
+int main() {
+    int count = 0, a = 0, b = 0;
+    if (cudaGetDeviceCount(&count) != cudaSuccess || count < 2 ||
+        cudaDeviceCanAccessPeer(&a, 0, 1) != cudaSuccess || cudaDeviceCanAccessPeer(&b, 1, 0) != cudaSuccess || !a || !b) {
+        std::puts("peer_decode_p2p_test: SKIP (two GPUs with bidirectional P2P required)"); return 77;
+    }
+    try {
+        for (int device : {0, 1}) {
+            strata::core::OnDevice on(device);
+            cuda_ok(cudaDeviceEnablePeerAccess(1 - device, 0));
+        }
+        run(false, false); run(true, false); run(false, true); run(true, true);
+        run(false, true, true); run(true, true, true);
+        run(false, true, true, false); run(true, true, true, false);
+    }
+    catch (const std::exception& e) { std::fprintf(stderr, "peer_decode_p2p_test: %s\n", e.what()); return 1; }
+    return 0;
+}
