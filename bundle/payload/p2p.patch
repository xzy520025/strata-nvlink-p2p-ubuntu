diff --git a/src/core/peer_decode.cu b/src/core/peer_decode.cu
new file mode 100644
index 00000000..5f607b67
--- /dev/null
+++ b/src/core/peer_decode.cu
@@ -0,0 +1,359 @@
+#include "strata/core/peer_decode.hpp"
+#include "strata/core/on_device.hpp"
+#include "strata/kernels/dp4a.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+
+namespace strata::core {
+namespace {
+bool ck(cudaError_t status, const char* what, std::string& err) {
+    if (status == cudaSuccess) return true;
+    err = std::string("peer decode P2P: ") + what + ": " + cudaGetErrorString(status);
+    return false;
+}
+
+__global__ void pack_rows(char* packet, size_t header, const float* rows, const int32_t* dst, int count, int width) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i == 0) ((int32_t*) packet)[0] = count;
+    if (i < count) ((int32_t*) packet)[1 + i] = dst[i];
+    for (int j = i; j < count * width; j += gridDim.x * blockDim.x)
+        ((float*) (packet + header))[j] = rows[j];
+    // packet belongs to the primary GPU. Every writer drains its peer stores before this kernel finishes;
+    // the following stream-ordered completion kernel may then publish the control word.
+    __threadfence_system();
+}
+
+__global__ void read_peer_input(float4* dst, const volatile float4* src, size_t count) {
+    const size_t i = (size_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count) dst[i] = make_float4(src[i].x, src[i].y, src[i].z, src[i].w);
+}
+
+__global__ void publish_ready(volatile uint32_t* flag, const volatile uint32_t* abort, uint32_t sequence) {
+    __threadfence_system();
+    if (!*abort) *flag = sequence;
+    __threadfence_system();
+}
+
+__global__ void wait_ready(const volatile uint32_t* flag, const volatile uint32_t* abort,
+                           uint32_t sequence, const volatile uint32_t* skip) {
+    if (skip && *skip == sequence) return;
+    while (*flag < sequence && !*abort) strata_spin_pause();
+    __threadfence_system();
+}
+
+__global__ void merge_rows(float* parts, const char* packet, size_t header, int capacity, int width,
+                           volatile uint32_t* abort, uint32_t sequence, const volatile uint32_t* skip) {
+    if (*abort || (skip && *skip == sequence)) return;
+    const int count = ((const int32_t*) packet)[0];
+    if (count < 0 || count > capacity) {
+        if (blockIdx.x == 0 && threadIdx.x == 0) { *abort = 1; __threadfence_system(); }
+        return;
+    }
+    const int row = blockIdx.x;
+    if (row >= count) return;
+    const int dst = ((const int32_t*) packet)[1 + row];
+    if (dst < 0 || dst >= capacity) {
+        if (threadIdx.x == 0) { *abort = 1; __threadfence_system(); }
+        return;
+    }
+    for (int col = threadIdx.x; col < width; col += blockDim.x)
+        parts[(size_t) dst * width + col] = ((const float*) (packet + header))[(size_t) row * width + col];
+}
+
+__global__ void copy_cpu_peer_rows(float4* parts, const volatile float4* cpu, const char* packet, size_t header,
+                                  int capacity, int width4, volatile uint32_t* abort, uint32_t sequence,
+                                  const volatile uint32_t* skip, const int32_t* primary_dst, const int32_t* primary_count) {
+    __shared__ int owner; // -2: aborted, -1: zero primary hit, >=0: peer compact row, -3: CPU
+    const int row = blockIdx.x;
+    if (threadIdx.x == 0) {
+        owner = -3;
+        if (*abort) owner = -2;
+        else if (skip && *skip == sequence) owner = -1;
+        else {
+            const int local = *primary_count;
+            const int peer = ((const int32_t*) packet)[0];
+            if (local < 0 || local > capacity || peer < 0 || peer > capacity) {
+                *abort = 1; __threadfence_system(); owner = -2;
+            } else {
+                for (int q = 0; q < local; ++q) if (primary_dst[q] == row) { owner = -1; break; }
+                if (owner == -3) for (int q = 0; q < peer; ++q)
+                    if (((const int32_t*) packet)[q + 1] == row) { owner = q; break; }
+            }
+        }
+    }
+    __syncthreads();
+    if (owner == -2) return;
+    for (int c = threadIdx.x; c < width4; c += blockDim.x) {
+        float4 value;
+        if (owner == -1) value = make_float4(0, 0, 0, 0);
+        else if (owner >= 0) value = ((const float4*) (packet + header))[(size_t) owner * width4 + c];
+        else {
+            const size_t i = (size_t) row * width4 + c;
+            value = make_float4(cpu[i].x, cpu[i].y, cpu[i].z, cpu[i].w);
+        }
+        parts[(size_t) row * width4 + c] = value;
+    }
+}
+
+// One CTA joins the peer and builds an index. Control words cross PCIe once here, rather than once per row.
+// The packet is immutable until this graph consumes it; the next same-group input depends on these results.
+__global__ void wait_and_index_rows(const volatile uint32_t* flag, volatile uint32_t* abort, uint32_t sequence,
+                                   const volatile uint32_t* skip, const char* packet, int capacity,
+                                   const int32_t* primary_dst, const int32_t* primary_count,
+                                   int32_t* owner, uint32_t* aborted, const volatile uint32_t* cpu_ready) {
+    __shared__ int local, peer, skipped, failed;
+    if (threadIdx.x == 0) {
+        skipped = skip && *skip == sequence;
+        if (!skipped)
+            while ((*flag < sequence || (cpu_ready && *cpu_ready < sequence)) && !*abort) strata_spin_pause();
+        __threadfence_system();
+        failed = *abort != 0;
+        local = peer = 0;
+        if (!failed && !skipped) {
+            local = *primary_count;
+            peer = ((const int32_t*) packet)[0];
+            if (local < 0 || local > capacity || peer < 0 || peer > capacity) {
+                *abort = 1; __threadfence_system(); failed = 1;
+            }
+        }
+        *aborted = (uint32_t) failed;
+    }
+    __syncthreads();
+    if (failed) return;
+    for (int row = threadIdx.x; row < capacity; row += blockDim.x) owner[row] = skipped ? -1 : -3;
+    if (skipped) return;
+    __syncthreads();
+    // Routing entries belong to exactly one tier. Scatter each compact destination once instead of
+    // searching both lists for every row; initialization and scatter stay inside this single CTA.
+    for (int q = threadIdx.x; q < local; q += blockDim.x) {
+        const int row = primary_dst[q];
+        if (row >= 0 && row < capacity) owner[row] = -1;
+        else atomicExch(&failed, 1);
+    }
+    for (int q = threadIdx.x; q < peer; q += blockDim.x) {
+        const int row = ((const int32_t*) packet)[q + 1];
+        if (row >= 0 && row < capacity) owner[row] = q;
+        else atomicExch(&failed, 1);
+    }
+    __syncthreads();
+    if (threadIdx.x == 0 && failed) {
+        *aborted = 1;
+        *abort = 1;
+        __threadfence_system();
+    }
+}
+
+__global__ void fill_indexed_rows(float4* parts, const volatile float4* cpu, const float4* peer,
+                                 const float4* primary_hits, const int32_t* owners, const uint32_t* aborted,
+                                 int width4) {
+    if (*aborted) return;
+    const int row = blockIdx.x;
+    const int owner = owners[row];
+    for (int c = threadIdx.x; c < width4; c += blockDim.x) {
+        const size_t i = (size_t) row * width4 + c;
+        float4 value;
+        if (owner == -1) {
+            value = primary_hits ? primary_hits[i] : make_float4(0, 0, 0, 0);
+            // Preserve the old zero-fill + add_hits arithmetic, including signed zero.
+            value = make_float4(__fadd_rn(0.0f, value.x), __fadd_rn(0.0f, value.y),
+                                __fadd_rn(0.0f, value.z), __fadd_rn(0.0f, value.w));
+        } else if (owner >= 0) value = peer[(size_t) owner * width4 + c];
+        else value = make_float4(cpu[i].x, cpu[i].y, cpu[i].z, cpu[i].w);
+        parts[i] = value;
+    }
+}
+} // namespace
+
+PeerDecodeTransport::~PeerDecodeTransport() { close(); }
+
+bool PeerDecodeTransport::open(int primary, int peer, int width, int capacity, int layers, std::string& err) {
+    close();
+    if (primary < 0 || peer < 0 || primary == peer || width <= 0 || capacity <= 0 || layers <= 0) {
+        err = "peer decode P2P: invalid geometry or devices"; return false;
+    }
+    int a = 0, b = 0;
+    if (!ck(cudaDeviceCanAccessPeer(&a, primary, peer), "query primary access", err) ||
+        !ck(cudaDeviceCanAccessPeer(&b, peer, primary), "query peer access", err)) return false;
+    const char* disabled = std::getenv("STRATA_PEER_NO_P2P");
+    if (!a || !b || (disabled && std::atoi(disabled))) {
+        err = "peer decode P2P: both devices must support direct peer access"; return false;
+    }
+    primary_ = primary; peer_ = peer; width_ = width; capacity_ = capacity;
+    header_bytes_ = ((size_t) (capacity + 1) * sizeof(int32_t) + 15) & ~size_t(15);
+    packet_bytes_ = header_bytes_ + (size_t) capacity * width * sizeof(float);
+    timing_ = std::getenv("STRATA_DECODE_TIMING") != nullptr;
+    {
+        OnDevice on(primary_);
+        for (int g = 0; g < 2; ++g) {
+            void** dst = &primary_packet_[g];
+            if (!ck(cudaMalloc(dst, packet_bytes_), "allocate packet", err) ||
+                !ck(cudaMemset(*dst, 0, packet_bytes_), "initialize packet", err)) { close(); return false; }
+            if (fast_join_ &&
+                (!ck(cudaMalloc((void**) &primary_owner_[g], capacity * sizeof(int32_t)), "row owner index", err) ||
+                 !ck(cudaMalloc((void**) &join_aborted_[g], sizeof(uint32_t)), "join state", err))) { close(); return false; }
+        }
+    }
+    {
+        OnDevice on(primary_);
+        if (!ck(cudaHostAlloc((void**) &flags_h_, 192, cudaHostAllocMapped | cudaHostAllocPortable), "control words", err) ||
+            !ck(cudaHostGetDevicePointer((void**) &flags_primary_, flags_h_, 0), "primary control alias", err)) {
+            close(); return false;
+        }
+        for (int i = 0; i < 48; ++i) flags_h_[i] = 0;
+    }
+    {
+        OnDevice on(peer_);
+        if (!ck(cudaHostGetDevicePointer((void**) &flags_peer_, flags_h_, 0), "peer control alias", err)) {
+            close(); return false;
+        }
+        if (timing_) {
+            traces_.resize((size_t) layers * 2);
+            for (auto& trace : traces_) for (auto& event : trace.event)
+                if (!ck(cudaEventCreate(&event), "timing event", err)) { close(); return false; }
+        }
+    }
+    std::fprintf(stderr, "strata verify: peer decode P2P CUDA%d <-> CUDA%d, %.2f MiB packets on the primary, "
+                         "peer kernel loads/stores and GPU-side result join%s\n", primary_, peer_, 2.0 * packet_bytes_ / (1 << 20),
+                         timing_ ? " (timing on)" : "");
+    return true;
+}
+
+void PeerDecodeTransport::release() {
+    if (!flags_h_) return;
+    *(volatile uint32_t*) (flags_h_ + 32) = 1;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    *(volatile uint32_t*) flags_h_ = UINT32_MAX;
+    *(volatile uint32_t*) (flags_h_ + 16) = UINT32_MAX;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+}
+
+bool PeerDecodeTransport::drain(std::string& err) {
+    if (peer_ < 0 || !work_) return true;
+    OnDevice on(peer_);
+    return ck(cudaStreamSynchronize(work_), "drain", err);
+}
+
+void PeerDecodeTransport::close() {
+    if (primary_ < 0) return;
+    release();
+    std::string ignored;
+    drain(ignored);
+    for (int device : {primary_, peer_}) {
+        OnDevice on(device);
+        if (device == primary_) for (int g = 0; g < 2; ++g) {
+            void*& ptr = primary_packet_[g];
+            if (ptr) cudaFree(ptr);
+            ptr = nullptr;
+            if (primary_owner_[g]) cudaFree(primary_owner_[g]);
+            if (join_aborted_[g]) cudaFree(join_aborted_[g]);
+            primary_owner_[g] = nullptr; join_aborted_[g] = nullptr;
+        }
+        if (device == peer_) for (auto& trace : traces_) for (auto event : trace.event)
+            if (event) cudaEventDestroy(event);
+    }
+    if (flags_h_) cudaFreeHost(flags_h_);
+    flags_h_ = flags_primary_ = flags_peer_ = nullptr;
+    traces_.clear();
+    work_ = nullptr; primary_ = peer_ = -1; trace_used_ = 0; input_pending_ = false;
+}
+
+bool PeerDecodeTransport::reset_window(std::string& err) {
+    if (!valid() || !flags_h_ || *(volatile uint32_t*) (flags_h_ + 32)) {
+        err = "peer decode P2P: an aborted transport cannot be reused"; return false;
+    }
+    *(volatile uint32_t*) flags_h_ = 0;
+    *(volatile uint32_t*) (flags_h_ + 16) = 0;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    trace_used_ = 0; input_pending_ = false;
+    return true;
+}
+
+bool PeerDecodeTransport::copy_input(float* dst, const float* src, size_t floats, cudaStream_t stream, std::string& err) {
+    if (!valid() || !flags_h_ || *(volatile uint32_t*) (flags_h_ + 32) || input_pending_ ||
+        floats > (size_t) capacity_ * width_ || (floats && (!src || !dst))) {
+        err = "peer decode P2P: invalid input submission"; return false;
+    }
+    work_ = stream;
+    if (timing_ && trace_used_ >= traces_.size()) { err = "peer decode P2P: too many layer groups"; return false; }
+    if (timing_ && !ck(cudaEventRecord(traces_[trace_used_].event[0], stream), "input start", err)) return false;
+    if (floats % 4) { err = "peer decode P2P: input must contain full float4 rows"; return false; }
+    if (floats) {
+        read_peer_input<<<(unsigned) ((floats / 4 + 255) / 256), 256, 0, stream>>>((float4*) dst, (const volatile float4*) src, floats / 4);
+        if (!ck(cudaPeekAtLastError(), "input peer load", err)) return false;
+    }
+    if (timing_ && !ck(cudaEventRecord(traces_[trace_used_].event[1], stream), "input end", err)) return false;
+    input_bytes += floats * sizeof(float);
+    input_pending_ = true;
+    return true;
+}
+
+bool PeerDecodeTransport::submit(int group, const float* rows, const int32_t* dst, int count, uint32_t sequence,
+                                 cudaStream_t stream, std::string& err) {
+    if (!valid() || !input_pending_ || group < 0 || group > 1 || count < 0 || count > capacity_ ||
+        !sequence || sequence == UINT32_MAX || (count && (!rows || !dst))) {
+        err = "peer decode P2P: invalid result submission"; return false;
+    }
+    if (timing_ && !ck(cudaEventRecord(traces_[trace_used_].event[2], stream), "compute end", err)) return false;
+    const int blocks = std::max(1, (count * width_ + 255) / 256);
+    pack_rows<<<blocks, 256, 0, stream>>>((char*) primary_packet_[group], header_bytes_, rows, dst, count, width_);
+    if (!ck(cudaPeekAtLastError(), "pack", err)) return false;
+    const size_t bytes = header_bytes_ + (size_t) count * width_ * sizeof(float);
+    if (timing_ && !ck(cudaEventRecord(traces_[trace_used_].event[3], stream), "output end", err)) return false;
+    publish_ready<<<1, 1, 0, stream>>>(flags_peer_ + group * 16, flags_peer_ + 32, sequence);
+    if (!ck(cudaPeekAtLastError(), "publish result", err)) return false;
+    // Flush the launch queue once, as Verifier does after cudaGraphLaunch. Without this the host can finish
+    // its CPU share and spin on the primary's next doorbell while the peer's last launches are still buffered.
+    const cudaError_t queued = cudaStreamQuery(stream);
+    if (queued != cudaSuccess && queued != cudaErrorNotReady && !ck(queued, "submit queue", err)) return false;
+    output_bytes += bytes; ++submissions; ++trace_used_; input_pending_ = false;
+    return true;
+}
+
+void PeerDecodeTransport::merge(int group, float* parts, int capacity, uint32_t sequence,
+                                const uint32_t* skip, cudaStream_t stream) {
+    wait_ready<<<1, 1, 0, stream>>>(flags_primary_ + group * 16, flags_primary_ + 32, sequence, skip);
+    merge_rows<<<capacity, 256, 0, stream>>>(parts, (const char*) primary_packet_[group], header_bytes_, capacity, width_,
+                                           flags_primary_ + 32, sequence, skip);
+}
+
+void PeerDecodeTransport::copy_cpu_rows(int group, float* parts, const float* cpu, int capacity, uint32_t sequence,
+                                        const uint32_t* skip, const int32_t* primary_dst, const int32_t* primary_count,
+                                        cudaStream_t stream, const float* primary_hits, const uint32_t* cpu_ready,
+                                        bool use_fast_join) {
+    if (fast_join_ && use_fast_join) {
+        wait_and_index_rows<<<1, 128, 0, stream>>>(flags_primary_ + group * 16, flags_primary_ + 32, sequence,
+            skip, (const char*) primary_packet_[group], capacity, primary_dst, primary_count,
+            primary_owner_[group], join_aborted_[group], cpu_ready);
+        fill_indexed_rows<<<capacity, 256, 0, stream>>>((float4*) parts, (const volatile float4*) cpu,
+            (const float4*) ((const char*) primary_packet_[group] + header_bytes_), (const float4*) primary_hits,
+            primary_owner_[group], join_aborted_[group], width_ / 4);
+        return;
+    }
+    wait_ready<<<1, 1, 0, stream>>>(flags_primary_ + group * 16, flags_primary_ + 32, sequence, skip);
+    copy_cpu_peer_rows<<<capacity, 256, 0, stream>>>((float4*) parts, (const volatile float4*) cpu,
+        (const char*) primary_packet_[group], header_bytes_, capacity, width_ / 4,
+        flags_primary_ + 32, sequence, skip, primary_dst, primary_count);
+}
+
+bool PeerDecodeTransport::complete(std::string& err) {
+    if (!flags_h_ || *(volatile uint32_t*) (flags_h_ + 32)) {
+        err = "peer decode P2P: the transport was aborted"; return false;
+    }
+    if (timing_) {
+        OnDevice on(peer_);
+        if (!drain(err)) return false;
+        for (size_t i = 0; i < trace_used_; ++i) {
+            float a = 0, b = 0, c = 0;
+            if (!ck(cudaEventElapsedTime(&a, traces_[i].event[0], traces_[i].event[1]), "input elapsed", err) ||
+                !ck(cudaEventElapsedTime(&b, traces_[i].event[1], traces_[i].event[2]), "compute elapsed", err) ||
+                !ck(cudaEventElapsedTime(&c, traces_[i].event[2], traces_[i].event[3]), "output elapsed", err)) return false;
+            input_ms += a; compute_ms += b; output_ms += c;
+        }
+        trace_used_ = 0;
+    }
+    return true;
+}
