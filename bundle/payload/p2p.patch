+// Optional CUDA peer decode transport. Payloads stay on the GPUs; only control words are mapped host memory.
+#pragma once
+
+#include <cuda_runtime.h>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+class PeerDecodeTransport {
+public:
+    PeerDecodeTransport() = default;
+    ~PeerDecodeTransport();
+    PeerDecodeTransport(const PeerDecodeTransport&) = delete;
+    PeerDecodeTransport& operator=(const PeerDecodeTransport&) = delete;
+
+    // PeerExperts enables access in both contexts first; this component does not change that shared context state.
+    bool open(int primary, int peer, int width, int capacity, int layers, std::string& err);
+    void close();
+    bool valid() const { return primary_ >= 0; }
+    void set_fast_join(bool enabled) { fast_join_ = enabled; } // before open/capture; default keeps the old graph
+    bool fast_join() const { return fast_join_; }
+    bool reset_window(std::string& err); // previous primary window must have completed
+    bool complete(std::string& err);     // after the primary graph has consumed every result
+    void release();                     // abort joins; the instance may never be reused
+    bool drain(std::string& err);
+
+    bool copy_input(float* peer_dst, const float* primary_src, size_t floats, cudaStream_t stream, std::string& err);
+    bool submit(int group, const float* rows, const int32_t* dst, int count, uint32_t sequence,
+                cudaStream_t stream, std::string& err);
+    // Capturable primary-side join and scatter. `skip == sequence` means the primary owns every row.
+    void merge(int group, float* parts, int capacity, uint32_t sequence, const uint32_t* skip, cudaStream_t stream);
+    // Primary rows are zero (or the supplied hits with fast_join); peer rows come from the device packet,
+    // and only CPU rows read host memory. Non-fast callers add their primary hits separately.
+    // fast_join can also join the CPU completion word here, replacing the caller's separate GPU wait.
+    // use_fast_join=false captures the original reader even when the transport supports fast joins.
+    void copy_cpu_rows(int group, float* parts, const float* cpu, int capacity, uint32_t sequence,
+                       const uint32_t* skip, const int32_t* primary_dst, const int32_t* primary_count,
+                       cudaStream_t stream, const float* primary_hits = nullptr, const uint32_t* cpu_ready = nullptr,
+                       bool use_fast_join = true);
+
+    uint64_t input_bytes = 0, output_bytes = 0, submissions = 0;
+    double input_ms = 0, compute_ms = 0, output_ms = 0;
+
+private:
+    int primary_ = -1, peer_ = -1, width_ = 0, capacity_ = 0;
+    size_t header_bytes_ = 0, packet_bytes_ = 0;
+    void* primary_packet_[2] = {};
+    int32_t* primary_owner_[2] = {}; // fast join: map router row to primary/peer/CPU owner
+    uint32_t* join_aborted_[2] = {}; // one mapped abort read at join instead of one per row
+    uint32_t* flags_h_ = nullptr;
+    uint32_t* flags_primary_ = nullptr;
+    uint32_t* flags_peer_ = nullptr;
+    cudaStream_t work_ = nullptr; // borrowed from PeerExperts, outlives this transport
+    struct Trace { cudaEvent_t event[4] = {}; };
+    std::vector<Trace> traces_;
+    size_t trace_used_ = 0;
+    bool timing_ = false, input_pending_ = false;
+    bool fast_join_ = false;
+};
+
+struct PeerDecodeView {
+    PeerDecodeTransport* transport = nullptr;
+    const float* input = nullptr; // normed rows on the primary, stable until merge
+    uint32_t sequence = 0;
+    int group = 0;
+};
+
+} // namespace strata::core
