+#include "strata/core/peer_decode.hpp"
+#include "strata/core/on_device.hpp"
+
+#include <cuda_runtime.h>
+#include <chrono>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+namespace {
+void require(bool ok, const std::string& e) { if (!ok) throw std::runtime_error(e); }
+void cuda_ok(cudaError_t e) { require(e == cudaSuccess, cudaGetErrorString(e)); }
+
+struct Watchdog {
+    std::atomic<bool> done{false};
+    std::thread thread;
+    explicit Watchdog(strata::core::PeerDecodeTransport& t) : thread([this, &t] {
+        for (int i = 0; i < 600 && !done.load(); ++i) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        if (!done.load()) t.release();
+    }) {}
+    void finish() { done.store(true); if (thread.joinable()) thread.join(); }
+    ~Watchdog() { finish(); }
+};
+
+void run(bool timing, bool combined, bool fast = false, bool use_fast = true) {
+    using namespace strata::core;
+    constexpr int width = 2560, capacity = 80;
+    std::string err;
+#if defined(_WIN32)
+    _putenv_s("STRATA_DECODE_TIMING", timing ? "1" : "");
+#else
+    if (timing) setenv("STRATA_DECODE_TIMING", "1", 1); else unsetenv("STRATA_DECODE_TIMING");
+#endif
+    PeerDecodeTransport transport;
+    transport.set_fast_join(fast);
+    require(transport.open(0, 1, width, capacity, 2, err), err);
+    Watchdog watchdog(transport);
+    float *input = nullptr, *parts = nullptr, *peer_input = nullptr, *peer_rows = nullptr, *primary_hits = nullptr;
+    int32_t* peer_dst = nullptr;
+    int32_t* primary_dst = nullptr;
+    int32_t* primary_count = nullptr;
+    float* cpu_h = nullptr;
+    float* cpu_m = nullptr;
+    uint32_t* skip = nullptr;
+    uint32_t *cpu_ready_h = nullptr, *cpu_ready_m = nullptr;
+    cudaStream_t primary_stream = nullptr, peer_stream = nullptr;
+    cudaGraph_t graph = nullptr;
+    cudaGraphExec_t exec = nullptr;
+    const size_t floats = (size_t) capacity * width, bytes = floats * sizeof(float);
+    {
+        OnDevice on(0);
+        cuda_ok(cudaMalloc((void**) &input, bytes));
+        cuda_ok(cudaMalloc((void**) &parts, bytes * 2));
+        if (fast) cuda_ok(cudaMalloc((void**) &primary_hits, bytes * 2));
+        cuda_ok(cudaMalloc((void**) &skip, 4));
+        cuda_ok(cudaMalloc((void**) &primary_dst, capacity * 4));
+        cuda_ok(cudaMalloc((void**) &primary_count, 4));
+        cuda_ok(cudaHostAlloc((void**) &cpu_h, bytes * 2, cudaHostAllocPortable | cudaHostAllocMapped));
+        cuda_ok(cudaHostGetDevicePointer((void**) &cpu_m, cpu_h, 0));
+        if (fast) {
+            cuda_ok(cudaHostAlloc((void**) &cpu_ready_h, 4, cudaHostAllocPortable | cudaHostAllocMapped));
+            cuda_ok(cudaHostGetDevicePointer((void**) &cpu_ready_m, cpu_ready_h, 0));
+            *cpu_ready_h = 0;
+        }
+        std::vector<int32_t> local;
+        for (int i = 0; i < capacity; ++i) if (i % 11 == 0) local.push_back(i);
+        const int32_t nlocal = (int32_t) local.size();
+        cuda_ok(cudaMemcpy(primary_dst, local.data(), local.size() * 4, cudaMemcpyHostToDevice));
+        cuda_ok(cudaMemcpy(primary_count, &nlocal, 4, cudaMemcpyHostToDevice));
+        cuda_ok(cudaMemset(skip, 0, 4));
+        cuda_ok(cudaStreamCreateWithFlags(&primary_stream, cudaStreamNonBlocking));
+        cuda_ok(cudaStreamBeginCapture(primary_stream, cudaStreamCaptureModeThreadLocal));
+        if (combined) {
+            transport.copy_cpu_rows(0, parts, cpu_m, capacity, 1, skip, primary_dst, primary_count,
+                                    primary_stream, primary_hits, cpu_ready_m, use_fast);
+            transport.copy_cpu_rows(1, parts + floats, cpu_m + floats, capacity, 2, nullptr, primary_dst, primary_count,
+                                    primary_stream, primary_hits ? primary_hits + floats : nullptr, cpu_ready_m, use_fast);
+        } else {
+            transport.merge(0, parts, capacity, 1, skip, primary_stream);
+            transport.merge(1, parts + floats, capacity, 2, nullptr, primary_stream);
+        }
+        cuda_ok(cudaStreamEndCapture(primary_stream, &graph));
+        cuda_ok(cudaGraphInstantiate(&exec, graph, 0));
+    }
+    {
+        OnDevice on(1);
+        cuda_ok(cudaMalloc((void**) &peer_input, bytes));
+        cuda_ok(cudaMalloc((void**) &peer_rows, bytes));
+        cuda_ok(cudaMalloc((void**) &peer_dst, capacity * 4));
+        cuda_ok(cudaStreamCreateWithFlags(&peer_stream, cudaStreamNonBlocking));
+    }
+    std::vector<float> activations(floats), rows[2], expected(floats * 2), actual(floats * 2), copied(floats);
+    std::vector<float> hits(floats * 2);
+    std::vector<int32_t> dst[2];
+    int passes = 0;
