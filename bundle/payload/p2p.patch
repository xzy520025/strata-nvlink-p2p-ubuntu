+    require(native_fmt(18, 20, 2560, 640, fmt[0], err), err);
+    require(native_fmt(uniform ? 18 : 17, 20, 2560, 640, fmt[1], err), err);
+    std::vector<std::vector<uint8_t>> truth(layers * experts);
+    {
+        std::ofstream metadata(fixture.path / "native_experts.txt");
+        std::ofstream weights(fixture.path / "experts.bin", std::ios::binary);
+        uint64_t offset = 0;
+        for (int l = 0; l < layers; ++l) {
+            metadata << l << ' ' << (l == 0 || uniform ? 18 : 17) << " 20 " << offset << ' ' << fmt[l].bytes << '\n';
+            for (int e = 0; e < experts; ++e) {
+                auto& data = truth[l * experts + e];
+                data.resize((size_t) fmt[l].bytes);
+                for (size_t i = 0; i < data.size(); ++i) data[i] = (uint8_t) ((i * 131 + e * 37 + l * 17) ^ (i >> 8));
+                weights.write((const char*) data.data(), (std::streamsize) data.size());
+            }
+            offset += (uint64_t) experts * fmt[l].bytes;
+        }
+        require((bool) metadata && (bool) weights, "write fixture");
+    }
+    require(expert_layout_load(fixture.path.string(), layers, experts, err), err);
+    FileExpertSource source;
+    ExpertCache primary;
+    PeerExperts peer;
+    require(source.open(fixture.path.string(), layers, experts, err), err);
+    const int64_t max_blob = std::max(fmt[0].bytes, fmt[1].bytes);
+    require(primary.open(2, layers, experts, max_blob, err), err);
+    for (int l = 0; l < layers; ++l) {
+        int slot = primary.admit(l, 0);
+        require(slot >= 0 && primary.fill_slot_blocking(slot, truth[l * experts].data(), err), err);
+    }
+    std::vector<std::pair<int32_t, int32_t>> rank;
+    for (int e = 0; e < experts; ++e)
+        for (int l = 0; l < layers; ++l) rank.emplace_back(l, e);
+    require(peer.open(1, rank, primary, source, layers, experts, 512, 2, err), err);
+    require(peer.resident_pairs() == std::vector<std::pair<int32_t, int32_t>>{{0,1},{1,1}}, "peer startup placement");
+    // Experts 0: primary; 1: peer; 2/3: RAM; 4: file-only. Exercise the budget path and file-only promotions.
+    const uint64_t ram_bytes = 2 * (uint64_t) (fmt[0].bytes + fmt[1].bytes);
+    require(source.pin_cache_complement(primary, err, pin, peer.resident_pairs(), -1, 0, ram_bytes, &rank), err);
+    require(source.resident_bytes() == ram_bytes, "both GPU tiers must be excluded from RAM");
+    require(source.reserve_exchanges(2, err), err);
+    require(peer.enable_ram_dedup(source, err), err);
+    require(source.exchange_rotation() == (uniform && pin && rotate), "exchange rotation mode");
+    std::vector<int32_t> r0(layers * experts, kNotResident);
+    for (int l = 0; l < layers; ++l) r0[l * experts] = primary.slot_of(l, 0);
+
+    auto check = [&] {
+        require(source.resident_bytes() == ram_bytes, "RAM allocation grew during adaptation");
+        for (int l = 0; l < layers; ++l)
+            for (int e = 0; e < experts; ++e) {
+                const bool p = primary.slot_of(l, e) >= 0, q = peer.has(l, e), r = source.has_resident(l, e);
+                require((int) p + (int) q + (int) r == (e == 4 ? 0 : 1), "lost or duplicated expert ownership");
+                const auto& expected = truth[l * experts + e];
+                if (r) require(std::memcmp(source.resident_blob(l, e), expected.data(), expected.size()) == 0, "RAM expert bytes changed");
+                if (q) {
+                    OnDevice on(1);
+                    std::vector<uint8_t> actual(expected.size());
+                    require(cudaMemcpy(actual.data(), peer.slot_ptr(l, e), actual.size(), cudaMemcpyDeviceToHost) == cudaSuccess,
+                            "read peer slot");
+                    require(actual == expected, "peer expert bytes changed");
+                }
+            }
+        std::vector<uint8_t> fallback((size_t) fmt[1].bytes);
+        require(source.copy_blob(1, 4, fallback.data()) && fallback == truth[experts + 4], "file fallback changed");
+    };
+    check();
+    for (int round = 0; round < 12; ++round) {
+        const int incoming = (round + 1) % 3 + 1; // 2 -> 3 -> 1, repeatedly evict and readmit the same experts.
+        std::vector<float> usage(layers * experts, 0.0f);
+        for (int l = 0; l < layers; ++l) {
+            usage[l * experts + incoming] = 10 + l;
+            usage[l * experts + 4] = 100; // no RAM place: must be skipped rather than losing an eviction.
+        }
+        require(peer.adapt(usage.data(), r0.data(), 2, err), err);
+        for (int l = 0; l < layers; ++l) require(peer.has(l, incoming), "hot RAM expert was not promoted");
+        check();
+    }
+    require(peer.swaps() == 24 && source.exchanges() == 24, "exchange accounting");
+    std::printf("peer RAM dedup: uniform=%d pinned=%d rotate=%d, 24 exchanges, ownership and exact bytes PASS\n",
+                uniform, pin, rotate);
+    peer.close();
+    require(peer.resident_pairs().empty(), "closed peer retained published residency");
+}
+
+} // namespace
+
+int main() {
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices < 2) {
+        std::puts("peer_ram_dedup_test: SKIP (needs two visible GPUs)");
+        return 77;
+    }
+    try {
+        run(false, true, false);
+        run(false, false, false);
+        run(true, true, true);
+        std::puts("peer_ram_dedup_test: PASS");
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "peer_ram_dedup_test: %s\n", e.what());
+        return 1;
+    }
+}
